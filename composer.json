{
  "name": "wordpress/two-factor",
  "type": "wordpress-plugin",
  "description": "Two-Factor Authentication for WordPress.",
  "license": "GPL-2.0-or-later",
  "homepage": "https://wordpress.org/plugins/two-factor/",
  "support": {
    "source": "https://github.com/WordPress/two-factor",
    "forum": "https://wordpress.org/support/plugin/two-factor/",
    "issues": "https://github.com/WordPress/two-factor/issues"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "7.4.0"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "repositories": [
    {
      "type": "package",
      "package": {
        "name": "wordpress/secrets-api",
        "version": "0.2.1",
        "type": "wordpress-plugin",
        "dist": {
          "type": "zip",
          "url": "https://github.com/ericmann/secrets-api/archive/refs/tags/v0.2.1.zip"
        },
        "require": {
          "php": ">=7.4"
        }
      }
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable" : true,
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "automattic/vipwpcs": "^3.0",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-stubs/wp-cli-stubs": "dev-master",
    "phpcompatibility/phpcompatibility-wp": "3.0.0-alpha2",
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^8.5|^9.6",
    "spatie/phpunit-watcher": "^1.23",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wordpress/secrets-api": "0.2.1",
    "wp-coding-standards/wpcs": "^3.3",
    "yoast/phpunit-polyfills": "^4.0"
  },
  "scripts": {
    "lint": "phpcs",
    "lint-compat": "phpcs -p --standard=PHPCompatibilityWP --runtime-set testVersion 7.2- --extensions=php --ignore='tests/,dist/,includes/Yubico/,vendor/,node_modules/' .",
    "lint-phpstan": "phpstan analyse --verbose --memory-limit=1G",
    "test-single": "phpunit --coverage-text",
    "test-multisite": "phpunit --coverage-text --config phpunit-multisite.xml",
    "test": [
      "@test-single",
      "@test-multisite"
    ],
    "test-watch-single": [
      "Composer\\Config::disableProcessTimeout",
      "phpunit-watcher watch --no-coverage"
    ],
    "test-watch-multisite": [
      "Composer\\Config::disableProcessTimeout",
      "phpunit-watcher watch --no-coverage --config phpunit-multisite.xml"
    ],
    "format": "phpcbf"
  }
}
